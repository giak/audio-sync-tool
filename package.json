{
  "name": "audio-sync-tool",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node build.js && node scripts/validate-build.js",
    "start": "fuser -k 8765/tcp 2>/dev/null; npm run build && ./venv/bin/python app.py",
    "dev": "node build.js --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "biome check static/src/",
    "lint:write": "biome check --write static/src/",
    "lint:unsafe": "biome check --write --unsafe static/src/",
    "format": "biome format --write static/src/",
    "format:check": "biome format static/src/",
    "coverage": "npm run coverage:clean && vitest run --coverage && npm run build",
    "coverage:clean": "rm -rf static/dist"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@vitest/coverage-v8": "^1.6.1",
    "esbuild": "^0.28.1",
    "jsdom": "^28.1.0",
    "typescript": "^6.0.3",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "wavesurfer.js": "7.12.11"
  }
}
